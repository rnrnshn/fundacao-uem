{
  "name": "fundacao-universitaria",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "build:vercel": "node scripts/build-vercel.mjs && tsc --noEmit",
    "verify:vercel": "node scripts/verify-vercel.mjs",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "pnpm build && playwright test",
    "seo:image": "node scripts/generate-social-image.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.1.1",
    "nitro": "latest",
    "tailwindcss": "^4.3.3",
    "typescript": "latest",
    "vite": "^8.3.1"
  }
}
